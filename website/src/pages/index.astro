---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import Features from '../components/Features.astro';
import Architecture from '../components/Architecture.astro';
import Verbs from '../components/Verbs.astro';
import QuickStart from '../components/QuickStart.astro';
import ExitCodes from '../components/ExitCodes.astro';
import Licensing from '../components/Licensing.astro';
import TechStack from '../components/TechStack.astro';
import Footer from '../components/Footer.astro';
---

<Layout>
  <Navbar />
  <main id="main" tabindex="-1">
    <Hero />
    <Features />
    <Architecture />
    <Verbs />
    <QuickStart />
    <ExitCodes />
    <Licensing />
    <TechStack />
  </main>
  <Footer />
</Layout>
