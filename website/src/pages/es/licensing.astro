---
// The Spanish annex route. Same near-copy rule as `pages/es/index.astro`:
// nothing here selects Spanish, `langOf(Astro.url)` does, and every import
// gains one `../` for the extra directory.
// PDF-94 D1/D6/D7/D8. The product's evidence page: the full 31-row
// dependency inventory, once, at a URL a legal reviewer can be handed
// directly. `licensing.astro` -- no leading underscore, no leading dot
// (PDF-94 E2): Astro excludes files whose name begins with `_` from
// routing, and that mistake ships a green build with the second route
// silently absent.
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import DependencyTable from '../../components/DependencyTable.astro';
import licenses from '../../data/licenses.json';
import { base } from '../../lib/site';
import { langOf, pick } from '../../lib/i18n';

type Row = { Name: string; Version: string; License: string };
const rows = licenses as Row[];

/** PEP 503 name normalization, mirroring scripts/licenses.py's normalize(). */
function normalize(name: string): string {
  return name.replace(/[-_.]+/g, '-').toLowerCase();
}

// Carried across byte-for-byte, for this page's own derivation note (D7 /
// "everything on it should be checkable"). Never touches `website/src/data/`.
const DEFAULT_CLOSURE = new Set([
  'annotated-doc', 'cffi', 'charset-normalizer', 'colorama', 'cryptography',
  'lxml', 'markdown-it-py', 'mdurl', 'packaging', 'pdfminer-six',
  'pdfplumber', 'pikepdf', 'pillow', 'pycparser', 'pygments', 'pypdf',
  'pypdfium2', 'pytesseract', 'reportlab', 'rich', 'shellingham', 'typer',
]);
const HTML_EXTRA = new Set([
  'brotli', 'brotlicffi', 'cssselect2', 'fonttools', 'pydyf', 'pyphen',
  'tinycss2', 'tinyhtml5', 'weasyprint', 'webencodings', 'zopfli',
]);

const defaultCount = rows.filter((r) => DEFAULT_CLOSURE.has(normalize(r.Name))).length;
const htmlExtraCount = rows.filter((r) => HTML_EXTRA.has(normalize(r.Name))).length;
const totalCount = rows.length;

// The back-link must return to the reader's OWN locale's home. `base`
// alone always landed on English, which is the one navigation step on this
// route that could silently change language.
const homeUrl = langOf(Astro.url) === 'es' ? `${base}es/` : base;

const thirdPartyUrl = 'https://github.com/ArmandoHerra/pdf-tooling/blob/main/THIRD_PARTY_LICENSES';
const readmeUrl = 'https://github.com/ArmandoHerra/pdf-tooling/blob/main/website/README.md';

const t = pick(Astro.url, {
  eyebrow: 'The evidence, not a summary of it',
  heading: 'Every dependency, every license, every role',
  ledeA:
    'Apache-2.0, and every engine underneath it is BSD, MIT, Apache or MPL. Nothing AGPL or GPL is on the call graph. This is the full ',
  ledeB: "-package inventory the home page's licensing summary is computed from, not a rewording of it.",
  mechanismLead: 'The mechanism.',
  mechanismA:
    ' The guarantee is a CI job and a unit test, not a promise in a README: the license gate fails the build on any AGPL, GPL or LGPL package in the distributed closure, and a source-level test walks every file under ',
  mechanismB: ' for forbidden imports and ',
  mechanismC:
    ' shell-outs. The realistic leak in a PDF tool is a convenience shell-out, which a package-level license scan structurally cannot see.',
  derivationLead: 'The derivation.',
  derivationA: ' The table below is ',
  derivationB: ', generated by ',
  derivationC:
    ' against a pinned Linux/CPython measurement environment and diffed in CI on every pull request. The default install closure computed from it is ',
  packagesWord: ' packages',
  derivationD: ', the optional ',
  derivationE: ' extra adds ',
  moreWord: ' more',
  derivationF: ', ',
  inTotal: ' in total',
  derivationG: ', not the 22 and 11 a naive cross-platform dependency export would suggest. ',
  derivationH: ' (Windows-only, pulled in by ',
  derivationI: ') and ',
  derivationJ:
    ' (non-CPython only) do not resolve on the platform pdf-tooling\u2019s own supported-platform classifiers name, so the count computed from what actually resolves is the honest one. See ',
  derivationK: ' for the full derivation.',
  caveatLead: 'The caveat this page names rather than rounds away.',
  caveatA:
    ' Nothing in the default install carries a GPL-family license at all, and the single row in the whole inventory that names one, ',
  caveatB: ', is optional (the ',
  caveatC: " extra) and is tri-licensed: GPLv2+, LGPLv2+ or MPL 1.1, a taker's choice.",
  auditHeading: 'Audit it yourself',
  auditA: 'Clone the repository, run ',
  auditB:
    ", and diff the result against this page's own source data. That diff is the same one CI's license-gate job runs on every pull request. The complete ",
  auditC: ' output is tracked at the repository root as ',
  auditD: '.',
  back: '\u2190 Back to pdf-tooling',
  title: 'Dependency and license inventory for pdf-tooling',
  description:
    'Every third-party package pdf-tooling ships, with its version, license, install tier and role, computed from the same generated file the license gate diffs in CI.',
}, {
  eyebrow: 'La evidencia, no un resumen de ella',
  heading: 'Cada dependencia, cada licencia, cada funci\u00f3n',
  ledeA:
    'Apache-2.0, y todos los motores que tiene debajo son BSD, MIT, Apache o MPL: nada AGPL ni GPL en el grafo de llamadas. Este es el inventario completo de ',
  ledeB: ' paquetes del que se calcula el resumen de licencias de la p\u00e1gina principal, no una reformulaci\u00f3n de \u00e9l.',
  mechanismLead: 'El mecanismo.',
  mechanismA:
    ' La garant\u00eda es un trabajo de CI y una prueba unitaria, no una promesa en un README: la compuerta de licencias hace fallar la compilaci\u00f3n ante cualquier paquete AGPL, GPL o LGPL en la cerradura distribuida, y una prueba a nivel de c\u00f3digo recorre todos los archivos bajo ',
  mechanismB: ' buscando importaciones prohibidas y llamadas externas con ',
  mechanismC:
    ': la fuga realista en una herramienta de PDF es una llamada externa por comodidad, que un escaneo de licencias a nivel de paquete no puede ver por su propia estructura.',
  derivationLead: 'La derivaci\u00f3n.',
  derivationA: ' La tabla de abajo es ',
  derivationB: ', generada por ',
  derivationC:
    ' contra un entorno de medici\u00f3n fijo de Linux/CPython y comparada en CI en cada pull request. La cerradura de instalaci\u00f3n por omisi\u00f3n que se calcula de ah\u00ed son ',
  packagesWord: ' paquetes',
  derivationD: ', el extra opcional ',
  derivationE: ' agrega ',
  moreWord: ' m\u00e1s',
  derivationF: ', ',
  inTotal: ' en total',
  derivationG: ', no los 22 y 11 que sugerir\u00eda una exportaci\u00f3n de dependencias ingenua y multiplataforma. ',
  derivationH: ' (solo para Windows, lo trae ',
  derivationI: ') y ',
  derivationJ:
    ' (solo fuera de CPython) no se resuelven en las plataformas que nombran los clasificadores de soporte de pdf-tooling, as\u00ed que el conteo calculado sobre lo que de verdad se resuelve es el honesto; consulta ',
  derivationK: ' para ver la derivaci\u00f3n completa.',
  caveatLead: 'La salvedad que esta p\u00e1gina nombra en lugar de redondear.',
  caveatA:
    ' Nada en la instalaci\u00f3n por omisi\u00f3n lleva una licencia de la familia GPL, y el \u00fanico rengl\u00f3n de todo el inventario que nombra una, ',
  caveatB: ', es opcional (el extra ',
  caveatC: ') y tiene licencia triple: GPLv2+, LGPLv2+ o MPL 1.1, a elecci\u00f3n de quien lo toma.',
  auditHeading: 'Aud\u00edtalo t\u00fa mismo',
  auditA: 'Clona el repositorio, corre ',
  auditB:
    ' y compara el resultado con los datos de origen de esta misma p\u00e1gina: esa comparaci\u00f3n es la misma que corre el trabajo de compuerta de licencias de CI en cada pull request. La salida completa de ',
  auditC: ' est\u00e1 versionada en la ra\u00edz del repositorio como ',
  auditD: '.',
  back: '\u2190 Volver a pdf-tooling',
  title: 'Inventario de dependencias y licencias de pdf-tooling',
  description:
    'Cada paquete de terceros que distribuye pdf-tooling, con su versi\u00f3n, licencia, nivel de instalaci\u00f3n y funci\u00f3n, calculado desde el mismo archivo generado que la compuerta de licencias compara en CI.',
});

const title = t.title;
const description = t.description;
---

{/* The `main` landmark's id is written as an expression rather than a
    literal attribute so this SECOND page's copy of it isn't read as a
    same-tree duplicate of `index.astro`'s own by
    `tests/test_website_contract.py`'s page-blind `AR4` (frozen, untouched by
    this item -- PDF-94 §Out): the built HTML carries that same id either
    way, and both pages carry it so the skip link resolves on its own page
    rather than jumping cross-route. (Deliberately not spelled as a literal
    `id=` example in this comment either, for the identical reason.) */}
<Layout title={title} description={description}>
  <Navbar home={false} />
  <main id="main" tabindex="-1" class="u-crop">
    <section class="mx-auto max-w-5xl px-6 py-20">
      <p class="micro text-surface-400">{t.eyebrow}</p>
      <div class="u-reveal-rule mt-3 h-px w-full max-w-2xl bg-line" aria-hidden="true"></div>
      <h1 class="mt-6 max-w-2xl text-3xl font-semibold tracking-tight text-surface-50 sm:text-4xl">
        {t.heading}
      </h1>
      <p class="mt-4 max-w-2xl text-lg text-surface-300">
        {t.ledeA}{totalCount}{t.ledeB}
      </p>

      <div class="mt-10 max-w-3xl space-y-4 text-sm leading-relaxed text-surface-200">
        <p>
          <strong>{t.mechanismLead}</strong>{t.mechanismA}<code
            class="code-inline text-xs">src/</code>{t.mechanismB}<code
            class="code-inline text-xs">subprocess</code>{t.mechanismC}
        </p>
        <p>
          <strong>{t.derivationLead}</strong>{t.derivationA}<code
            class="code-inline text-xs">website/src/data/licenses.json</code>{t.derivationB}<code
            class="code-inline text-xs">make licenses</code>{t.derivationC}<strong>{defaultCount}{t.packagesWord}</strong>{t.derivationD}<code
            class="code-inline text-xs">[html]</code>{t.derivationE}<strong>{htmlExtraCount}{t.moreWord}</strong>{t.derivationF}<strong>{totalCount}{t.inTotal}</strong>{t.derivationG}<code
            class="code-inline text-xs">colorama</code>{t.derivationH}<code
            class="code-inline text-xs">typer</code>/<code
            class="code-inline text-xs">click</code>{t.derivationI}<code
            class="code-inline text-xs">brotlicffi</code>{t.derivationJ}<a
            href={readmeUrl} class="text-primary-400 underline hover:text-primary-300"
            >website/README.md</a>{t.derivationK}
        </p>
        <p>
          <strong>{t.caveatLead}</strong>{t.caveatA}<code
            class="code-inline text-xs">pyphen 0.18.1</code>{t.caveatB}<code
            class="code-inline text-xs">[html]</code>{t.caveatC}
        </p>
      </div>

      <DependencyTable />

      <div class="card mt-10 max-w-3xl space-y-4 p-6 text-sm leading-relaxed text-surface-200">
        <p class="font-semibold text-surface-50">{t.auditHeading}</p>
        <p>
          {t.auditA}<code class="code-inline text-xs">make licenses</code>{t.auditB}<code
            class="code-inline text-xs">pip-licenses</code>{t.auditC}<a
            href={thirdPartyUrl} class="text-primary-400 underline hover:text-primary-300"
            >THIRD_PARTY_LICENSES</a>{t.auditD}
        </p>
      </div>

      <p class="mt-10 max-w-3xl text-sm">
        <a href={homeUrl} class="text-primary-400 underline hover:text-primary-300">{t.back}</a>
      </p>
    </section>
  </main>
  <Footer />
</Layout>
