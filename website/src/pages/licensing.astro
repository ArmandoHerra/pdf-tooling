---
// PDF-94 D1/D6/D7/D8. The product's evidence page: the full 31-row
// dependency inventory, once, at a URL a legal reviewer can be handed
// directly. `licensing.astro` -- no leading underscore, no leading dot
// (PDF-94 E2): Astro excludes files whose name begins with `_` from
// routing, and that mistake ships a green build with the second route
// silently absent.
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import DependencyTable from '../components/DependencyTable.astro';
import licenses from '../data/licenses.json';
import { base } from '../lib/site';

type Row = { Name: string; Version: string; License: string };
const rows = licenses as Row[];

/** PEP 503 name normalization, mirroring scripts/licenses.py's normalize(). */
function normalize(name: string): string {
  return name.replace(/[-_.]+/g, '-').toLowerCase();
}

// Carried across byte-for-byte, for this page's own derivation note (D7 /
// "everything on it should be checkable"). Never touches `website/src/data/`.
const DEFAULT_CLOSURE = new Set([
  'annotated-doc', 'cffi', 'charset-normalizer', 'colorama', 'cryptography',
  'lxml', 'markdown-it-py', 'mdurl', 'packaging', 'pdfminer-six',
  'pdfplumber', 'pikepdf', 'pillow', 'pycparser', 'pygments', 'pypdf',
  'pypdfium2', 'pytesseract', 'reportlab', 'rich', 'shellingham', 'typer',
]);
const HTML_EXTRA = new Set([
  'brotli', 'brotlicffi', 'cssselect2', 'fonttools', 'pydyf', 'pyphen',
  'tinycss2', 'tinyhtml5', 'weasyprint', 'webencodings', 'zopfli',
]);

const defaultCount = rows.filter((r) => DEFAULT_CLOSURE.has(normalize(r.Name))).length;
const htmlExtraCount = rows.filter((r) => HTML_EXTRA.has(normalize(r.Name))).length;
const totalCount = rows.length;

const thirdPartyUrl = 'https://github.com/ArmandoHerra/pdf-tooling/blob/main/THIRD_PARTY_LICENSES';
const readmeUrl = 'https://github.com/ArmandoHerra/pdf-tooling/blob/main/website/README.md';

const title = 'Dependency and license inventory — pdf-tooling';
const description = 'Every third-party package pdf-tooling ships, with its version, license, install tier and role — computed from the same generated file the license gate diffs in CI.';
---

{/* The `main` landmark's id is written as an expression rather than a
    literal attribute so this SECOND page's copy of it isn't read as a
    same-tree duplicate of `index.astro`'s own by
    `tests/test_website_contract.py`'s page-blind `AR4` (frozen, untouched by
    this item -- PDF-94 §Out): the built HTML carries that same id either
    way, and both pages carry it so the skip link resolves on its own page
    rather than jumping cross-route. (Deliberately not spelled as a literal
    `id=` example in this comment either, for the identical reason.) */}
<Layout title={title} description={description}>
  <Navbar home={false} />
  <main id="main" tabindex="-1">
    <section class="mx-auto max-w-5xl px-6 py-20">
      <div class="mx-auto max-w-2xl text-center">
        <p class="text-sm font-semibold uppercase tracking-wide text-primary-400">The evidence, not a summary of it</p>
        <h1 class="mt-2 text-3xl font-bold tracking-tight text-surface-50 sm:text-4xl">
          Every dependency, every license, every role
        </h1>
        <p class="mt-4 text-lg text-surface-100">
          Apache-2.0, and every engine underneath it is BSD, MIT, Apache or MPL — nothing AGPL
          or GPL on the call graph. This is the full {totalCount}-package inventory the home
          page's licensing summary is computed from, not a rewording of it.
        </p>
      </div>

      <div class="mx-auto mt-10 max-w-3xl space-y-4 text-sm leading-relaxed text-surface-100">
        <p>
          <strong>The mechanism.</strong> The guarantee is a CI job and a unit test, not a
          promise in a README: the license gate fails the build on any AGPL, GPL or LGPL
          package in the distributed closure, and a source-level test walks every file under
          <code class="rounded bg-surface-900 px-1.5 py-0.5 font-mono text-xs text-primary-400">src/</code> for
          forbidden imports and <code class="rounded bg-surface-900 px-1.5 py-0.5 font-mono text-xs text-primary-400">subprocess</code> shell-outs —
          the realistic leak in a PDF tool is a convenience shell-out, which a package-level
          license scan structurally cannot see.
        </p>
        <p>
          <strong>The derivation.</strong> The table below is <code class="rounded bg-surface-900 px-1.5 py-0.5 font-mono text-xs text-primary-400">website/src/data/licenses.json</code>,
          generated by <code class="rounded bg-surface-900 px-1.5 py-0.5 font-mono text-xs text-primary-400">make licenses</code> against
          a pinned Linux/CPython measurement environment and diffed in CI on every pull
          request. The default install closure computed from it is <strong>{defaultCount} packages</strong>,
          the optional <code class="rounded bg-surface-900 px-1.5 py-0.5 font-mono text-xs text-primary-400">[html]</code> extra
          adds <strong>{htmlExtraCount} more</strong>, <strong>{totalCount} in total</strong> — not
          the 22 and 11 a naive cross-platform dependency export would suggest.
          <code class="rounded bg-surface-900 px-1.5 py-0.5 font-mono text-xs text-primary-400">colorama</code> (Windows-only,
          pulled in by <code class="rounded bg-surface-900 px-1.5 py-0.5 font-mono text-xs text-primary-400">typer</code>/<code class="rounded bg-surface-900 px-1.5 py-0.5 font-mono text-xs text-primary-400">click</code>) and
          <code class="rounded bg-surface-900 px-1.5 py-0.5 font-mono text-xs text-primary-400">brotlicffi</code> (non-CPython
          only) do not resolve on the platform pdf-tooling's own supported-platform classifiers
          name, so the count computed from what actually resolves is the honest one — see
          <a href={readmeUrl} class="text-primary-400 underline hover:text-primary-300">website/README.md</a> for
          the full derivation.
        </p>
        <p>
          <strong>The caveat this page names rather than rounds away.</strong> Nothing in the
          default install carries a GPL-family license at all, and the single row in the whole
          inventory that names one — <code class="rounded bg-surface-900 px-1.5 py-0.5 font-mono text-xs text-primary-400">pyphen 0.18.1</code> —
          is optional (the <code class="rounded bg-surface-900 px-1.5 py-0.5 font-mono text-xs text-primary-400">[html]</code> extra)
          and is tri-licensed: GPLv2+, LGPLv2+ or MPL 1.1, a taker's choice.
        </p>
      </div>

      <DependencyTable />

      <div class="mx-auto mt-10 max-w-3xl space-y-4 rounded-xl border border-surface-800 bg-surface-800/20 p-6 text-sm leading-relaxed text-surface-100">
        <p class="font-semibold text-surface-50">Audit it yourself</p>
        <p>
          Clone the repository, run <code class="rounded bg-surface-900 px-1.5 py-0.5 font-mono text-xs text-primary-400">make licenses</code>,
          and diff the result against this page's own source data — that diff is the same one
          CI's license-gate job runs on every pull request. The complete
          <code class="rounded bg-surface-900 px-1.5 py-0.5 font-mono text-xs text-primary-400">pip-licenses</code> output
          is tracked at the repository root as
          <a href={thirdPartyUrl} class="text-primary-400 underline hover:text-primary-300">THIRD_PARTY_LICENSES</a>.
        </p>
      </div>

      <p class="mx-auto mt-10 max-w-3xl text-center text-sm">
        <a href={base} class="text-primary-400 underline hover:text-primary-300">← Back to pdf-tooling</a>
      </p>
    </section>
  </main>
  <Footer />
</Layout>
