---
// PDF-94 D7. The home page's licence section, replacing `Licensing.astro`
// and `TechStack.astro` (both deleted): the claim, the guarantee mechanism,
// the computed figures, the two honest caveats, and one link to the full
// inventory at `/licensing/`. Keeps the `licensing` section id -- the
// published anchor (AC9) -- even though the 31-row table itself has moved
// off this page. (Deliberately not spelled as a literal `id=` example in
// this comment: `tests/test_website_contract.py`'s AR2/AR4 scan this tree
// for exactly that attribute shape, and a worked example here would
// double-count as one of its own targets -- the same reason `sections.ts`
// gives for the identical omission.)
import licenses from '../data/licenses.json';
import { withBase } from '../lib/site';
import { langPath, pick } from '../lib/i18n';

type Row = { Name: string; Version: string; License: string };
const rows = licenses as Row[];

/** PEP 503 name normalization, mirroring scripts/licenses.py's normalize(). */
function normalize(name: string): string {
  return name.replace(/[-_.]+/g, '-').toLowerCase();
}

// Carried across from `Licensing.astro` byte-for-byte (PDF-16 R-9). Not
// re-derived independently of `DependencyTable.astro` -- both consume
// `licenses.json` and compute their own figures the same way (D7); neither
// touches `website/src/data/`.
const DEFAULT_CLOSURE = new Set([
  'annotated-doc', 'cffi', 'charset-normalizer', 'colorama', 'cryptography',
  'lxml', 'markdown-it-py', 'mdurl', 'packaging', 'pdfminer-six',
  'pdfplumber', 'pikepdf', 'pillow', 'pycparser', 'pygments', 'pypdf',
  'pypdfium2', 'pytesseract', 'reportlab', 'rich', 'shellingham', 'typer',
]);
const HTML_EXTRA = new Set([
  'brotli', 'brotlicffi', 'cssselect2', 'fonttools', 'pydyf', 'pyphen',
  'tinycss2', 'tinyhtml5', 'weasyprint', 'webencodings', 'zopfli',
]);

// Computed from the data, never typed (D7 item 3 / AC6) -- mirrors the
// mechanism `Licensing.astro:45-49` already used.
const defaultCount = rows.filter((r) => DEFAULT_CLOSURE.has(normalize(r.Name))).length;
const htmlExtraCount = rows.filter((r) => HTML_EXTRA.has(normalize(r.Name))).length;
const totalCount = rows.length;

const pikepdf = rows.find((r) => normalize(r.Name) === 'pikepdf');
const pyphen = rows.find((r) => normalize(r.Name) === 'pyphen');

const thirdPartyUrl = 'https://github.com/ArmandoHerra/pdf-tooling/blob/main/THIRD_PARTY_LICENSES';
const inventoryUrl = withBase(langPath(Astro.url, 'licensing/'));

// Every count in this section is computed from `licenses.json` and is the
// same integer in both languages; the licence IDENTIFIERS (Apache-2.0,
// MPL-2.0, GPLv2+, the `[html]` extra, `THIRD_PARTY_LICENSES`, `NOTICE`)
// are names, not words, and are not translated either.
const t = pick(Astro.url, {
  eyebrow: 'Licensing',
  heading: 'Licensing',
  lede: 'Apache-2.0, and every engine underneath it is BSD, MIT, Apache or MPL. No AGPL or GPL code is reachable from anything that runs.',
  gateA:
    'This is checked by a CI job and a test, not promised in a README. The licence gate fails the build if any AGPL, GPL or LGPL package would ship, and a test reads every file under ',
  gateB: ' for forbidden imports and ',
  gateC: ' calls out to other programs. That is the realistic leak a package-level licence scan cannot see on its own.',
  countsA:
    'These numbers come from the same generated inventory the full list publishes. A default install pulls in ',
  packagesWord: ' packages',
  countsB: ', the optional ',
  countsC: ' extra adds ',
  moreWord: ' more',
  countsD: ', ',
  countsE: ' in total.',
  pikepdfA: ' bundles libqpdf under ',
  pikepdfB:
    ', which is copyleft file by file. It is used unmodified, as a dependency, which is what makes it Apache-compatible. It is documented in ',
  pikepdfC: ' and the full ',
  pikepdfD: ' inventory.',
  pyphenLead:
    'No package in the default install carries a GPL-family licence, and the one row in the whole inventory that does is optional and offers MPL 1.1 as an alternative:',
  pyphenA: ' enters only through the optional ',
  pyphenB: ' extra, tri-licensed',
  pyphenC: ' GPLv2+, LGPLv2+ or MPL 1.1, whichever you choose.',
  allLead: 'All ',
  allRest: ' packages, with licenses, tiers and roles \u2192',
  fullLead: 'Full inventory: ',
}, {
  eyebrow: 'Licencias',
  heading: 'Licencias',
  lede: 'Apache-2.0, y todos los motores que tiene debajo son BSD, MIT, Apache o MPL: nada AGPL ni GPL en el grafo de llamadas.',
  gateA:
    'La garant\u00eda es un trabajo de CI y una prueba unitaria, no una promesa en un README: la compuerta de licencias hace fallar la compilaci\u00f3n ante cualquier paquete AGPL, GPL o LGPL en la cerradura distribuida, y una prueba a nivel de c\u00f3digo recorre todos los archivos bajo ',
  gateB: ' buscando importaciones prohibidas y llamadas externas con ',
  gateC: ': la fuga realista que un escaneo de licencias a nivel de paquete no puede ver por s\u00ed solo.',
  countsA:
    'Calculado directo del mismo inventario generado que publica el inventario completo: la cerradura de instalaci\u00f3n por omisi\u00f3n son ',
  packagesWord: ' paquetes',
  countsB: ', el extra opcional ',
  countsC: ' agrega ',
  moreWord: ' m\u00e1s',
  countsD: ', ',
  countsE: ' en total.',
  pikepdfA: ' incluye libqpdf bajo ',
  pikepdfB:
    ': copyleft a nivel de archivo, usado sin modificar como dependencia y compatible con Apache sobre esa base. Est\u00e1 documentado en ',
  pikepdfC: ' y en el inventario completo ',
  pikepdfD: '.',
  pyphenLead:
    'Nada en la instalaci\u00f3n por omisi\u00f3n lleva una licencia de la familia GPL, y el \u00fanico rengl\u00f3n de todo el inventario que nombra una es opcional y ofrece MPL 1.1 como alternativa:',
  pyphenA: ' entra \u00fanicamente a trav\u00e9s del extra opcional ',
  pyphenB: ', con licencia triple',
  pyphenC: ' GPLv2+, LGPLv2+ o MPL 1.1, a elecci\u00f3n de quien lo toma.',
  allLead: 'Los ',
  allRest: ' paquetes, con licencias, niveles y funciones \u2192',
  fullLead: 'Inventario completo: ',
});
---

<section id="licensing" class="u-crop border-t border-line bg-surface-850 py-24">
  <div class="mx-auto max-w-3xl px-6">
    <p class="micro text-surface-400"><span class="text-primary-400">&sect;06</span> / {t.eyebrow}</p>
    <div class="u-reveal-rule mt-3 h-px w-full bg-line" aria-hidden="true"></div>
    <h2 class="mt-6 text-3xl font-semibold tracking-tight text-surface-50 sm:text-4xl">{t.heading}</h2>
    <p class="mt-4 max-w-2xl text-lg text-surface-300">
      {t.lede}
    </p>

    <div class="mt-10 max-w-2xl space-y-4 text-sm leading-relaxed text-surface-200">
      <p>
        {t.gateA}<code class="code-inline text-xs">src/</code>{t.gateB}<code
          class="code-inline text-xs">subprocess</code>{t.gateC}
      </p>
      <p>
        {t.countsA}<strong>{defaultCount}{t.packagesWord}</strong>{t.countsB}<code
          class="code-inline text-xs">[html]</code>{t.countsC}<strong>{htmlExtraCount}{t.moreWord}</strong>{t.countsD}<strong>{totalCount}{t.packagesWord}</strong>{t.countsE}
      </p>
      {pikepdf && (
        <p>
          <code class="code-inline text-xs">pikepdf</code>{t.pikepdfA}<strong>{pikepdf.License}</strong>{t.pikepdfB}<code
            class="code-inline text-xs">NOTICE</code>{t.pikepdfC}<a
            href={thirdPartyUrl} class="text-primary-400 underline hover:text-primary-300"
            >THIRD_PARTY_LICENSES</a>{t.pikepdfD}
        </p>
      )}
      <p>
        {t.pyphenLead}
        {pyphen && (
          <>
            {' '}<code class="code-inline text-xs">{pyphen.Name} {pyphen.Version}</code>{t.pyphenA}<code
              class="code-inline text-xs">[html]</code>{t.pyphenB}
          </>
        )}
        {t.pyphenC}
      </p>
    </div>

    <p class="mt-10 max-w-2xl">
      <a href={inventoryUrl} class="font-semibold text-primary-400 underline hover:text-primary-300">
        {t.allLead}{totalCount}{t.allRest}
      </a>
    </p>

    <p class="mt-6 text-sm text-surface-300">
      {t.fullLead}<a href={thirdPartyUrl} class="text-primary-400 underline hover:text-primary-300">THIRD_PARTY_LICENSES</a>.
    </p>
  </div>
</section>
