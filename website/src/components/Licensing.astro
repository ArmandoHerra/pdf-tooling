---
import licenses from '../data/licenses.json';

type Row = { Name: string; Version: string; License: string };
const rows = licenses as Row[];

/** PEP 503 name normalization, mirroring scripts/licenses.py's normalize(). */
function normalize(name: string): string {
  return name.replace(/[-_.]+/g, '-').toLowerCase();
}

// Hand-authored closures (PDF-16 R-9). Derived from:
//   uv export --frozen --no-dev --no-emit-project --no-hashes --format requirements.txt
//   uv export --frozen --no-dev --all-extras --no-emit-project --no-hashes --format requirements.txt
// Re-run 2026-08-29. licenses.json is generated by `make licenses` against a
// PINNED LINUX/CPython-3.11 measurement venv (scripts/licenses.py), so it
// omits platform-marker-only packages (colorama: Windows only via
// typer/click; brotlicffi: non-CPython only) that `uv export`'s universal
// lockfile still lists. pdf-toolkit's own pyproject.toml classifiers name
// only POSIX/Linux and macOS as supported platforms, so the count computed
// below — from what actually resolves on a supported platform — is the
// honest one; see the PDF-16 Implementation Log for the full derivation.
const DEFAULT_CLOSURE = new Set([
  'annotated-doc', 'cffi', 'charset-normalizer', 'colorama', 'cryptography',
  'lxml', 'markdown-it-py', 'mdurl', 'packaging', 'pdfminer-six',
  'pdfplumber', 'pikepdf', 'pillow', 'pycparser', 'pygments', 'pypdf',
  'pypdfium2', 'pytesseract', 'reportlab', 'rich', 'shellingham', 'typer',
]);
const HTML_EXTRA = new Set([
  'brotli', 'brotlicffi', 'cssselect2', 'fonttools', 'pydyf', 'pyphen',
  'tinycss2', 'tinyhtml5', 'weasyprint', 'webencodings', 'zopfli',
]);

function tier(name: string): { label: string; classes: string } | null {
  const n = normalize(name);
  if (DEFAULT_CLOSURE.has(n)) return null;
  if (HTML_EXTRA.has(n)) return { label: 'optional · [html] extra', classes: 'bg-surface-800 text-surface-100' };
  return { label: 'build tooling', classes: 'bg-surface-800 text-surface-100' };
}

// Computed from the data, never typed — mirrors the Verbs section heading
// mechanism (PDF-16 D5). Measured 2026-08-29: 21, not the 22 a naive
// cross-platform `uv export` count would suggest, for the reason in the
// comment above.
const defaultCount = rows.filter((r) => DEFAULT_CLOSURE.has(normalize(r.Name))).length;
const htmlExtraCount = rows.filter((r) => HTML_EXTRA.has(normalize(r.Name))).length;
const gplInDefault = rows.some(
  (r) => DEFAULT_CLOSURE.has(normalize(r.Name)) && /AGPL|GPL|LGPL/i.test(r.License)
);

const pikepdf = rows.find((r) => normalize(r.Name) === 'pikepdf');
const pyphen = rows.find((r) => normalize(r.Name) === 'pyphen');

const thirdPartyUrl = 'https://github.com/ArmandoHerra/pdf-toolkit/blob/main/THIRD_PARTY_LICENSES';
---

<section id="licensing" class="border-t border-surface-800 bg-surface-800/20 py-24">
  <div class="mx-auto max-w-5xl px-6">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-3xl font-bold tracking-tight text-surface-50 sm:text-4xl">Licensing</h2>
      <p class="mt-4 text-lg text-surface-100">
        Apache-2.0, and every engine underneath it is BSD, MIT, Apache or MPL — nothing AGPL
        or GPL on the call graph.
      </p>
    </div>

    <div class="mx-auto mt-10 max-w-3xl space-y-4 text-sm leading-relaxed text-surface-100">
      <p>
        The guarantee is a CI job and a unit test, not a promise in a README: the license gate
        fails the build on any AGPL, GPL or LGPL package in the distributed closure, and a
        source-level test walks every file under <code class="rounded bg-surface-900 px-1.5 py-0.5 font-mono text-xs text-primary-400">src/</code> for
        forbidden imports and <code class="rounded bg-surface-900 px-1.5 py-0.5 font-mono text-xs text-primary-400">subprocess</code> shell-outs.
      </p>
      {pikepdf && (
        <p>
          <code class="rounded bg-surface-900 px-1.5 py-0.5 font-mono text-xs text-primary-400">pikepdf</code> bundles
          libqpdf under <strong>{pikepdf.License}</strong> — file-level copyleft, used unmodified as a
          dependency, and Apache-compatible on that basis. It is documented in <code class="rounded bg-surface-900 px-1.5 py-0.5 font-mono text-xs text-primary-400">NOTICE</code> and
          the full <a href={thirdPartyUrl} class="text-primary-400 underline hover:text-primary-300">THIRD_PARTY_LICENSES</a> inventory.
        </p>
      )}
      <p>
        The default install closure is <strong>{defaultCount} packages</strong>, with
        {gplInDefault ? ' a GPL-family package present — see the table below.' : ' no GPL-licensed package at all.'}
        {pyphen && (
          <>
            {' '}<code class="rounded bg-surface-900 px-1.5 py-0.5 font-mono text-xs text-primary-400">pyphen</code> ({pyphen.License}) enters
            only via the optional <code class="rounded bg-surface-900 px-1.5 py-0.5 font-mono text-xs text-primary-400">[html]</code> extra
            ({htmlExtraCount} additional packages) — Phase 2, and not shipped in v1.
          </>
        )}
      </p>
    </div>

    <div tabindex="0" class="mt-10 overflow-x-auto rounded-xl border border-surface-800">
      <table class="w-full border-collapse text-left text-sm">
        <thead>
          <tr class="border-b border-surface-800 bg-surface-800/40 text-surface-100">
            <th class="px-4 py-3 font-semibold">Package</th>
            <th class="px-4 py-3 font-semibold">Version</th>
            <th class="px-4 py-3 font-semibold">License</th>
            <th class="px-4 py-3 font-semibold">Tier</th>
          </tr>
        </thead>
        <tbody>
          {rows.map((r, i) => {
            const badge = tier(r.Name);
            return (
              <tr class={i % 2 === 0 ? 'bg-surface-900' : 'bg-surface-800/20'}>
                <td class="px-4 py-3 font-medium text-surface-50">{r.Name}</td>
                <td class="px-4 py-3 font-mono text-xs text-primary-400">{r.Version}</td>
                <td class="px-4 py-3 text-surface-100">{r.License}</td>
                <td class="px-4 py-3">
                  {badge ? (
                    <span class={`rounded px-2 py-1 text-[10px] font-semibold uppercase tracking-wide ${badge.classes}`}>
                      {badge.label}
                    </span>
                  ) : (
                    <span class="text-xs text-surface-100/60">default install</span>
                  )}
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>

    <p class="mt-6 text-center text-sm text-surface-100">
      Full inventory: <a href={thirdPartyUrl} class="text-primary-400 underline hover:text-primary-300">THIRD_PARTY_LICENSES</a>.
    </p>
  </div>
</section>
