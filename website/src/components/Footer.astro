---
const githubUrl = 'https://github.com/ArmandoHerra/pdf-tooling';
const docsUrl = 'https://github.com/ArmandoHerra/pdf-tooling#readme';
const changelogUrl = 'https://github.com/ArmandoHerra/pdf-tooling/blob/main/changelog.md';
const licenseUrl = 'https://github.com/ArmandoHerra/pdf-tooling/blob/main/LICENSE';
// R-11: THIRD_PARTY_LICENSES is tracked on main at Phase A landing time, so
// the conditional link resolves to "include it" rather than "omit it".
const thirdPartyUrl = 'https://github.com/ArmandoHerra/pdf-tooling/blob/main/THIRD_PARTY_LICENSES';
const year = new Date().getFullYear();
---

<footer class="u-crop border-t border-line">
  <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-4 px-6 py-10 sm:flex-row">
    <p class="text-center font-mono text-xs text-surface-400 sm:text-left">&copy; {year} pdf-tooling — Apache-2.0. Contributions accepted under the DCO (<code class="code-inline text-[10px]">git commit -s</code>).</p>
    <div class="micro flex flex-wrap items-center justify-center gap-6 text-surface-400">
      <a href={githubUrl} class="hover:text-primary-400">GitHub</a>
      <a href={docsUrl} class="hover:text-primary-400">README</a>
      <a href={changelogUrl} class="hover:text-primary-400">Changelog</a>
      <a href={thirdPartyUrl} class="hover:text-primary-400">Third-Party Licenses</a>
      <a href={licenseUrl} class="hover:text-primary-400">License</a>
    </div>
  </div>
</footer>
