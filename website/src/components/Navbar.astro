---
import PdfToolingLogo from '../assets/pdf-tooling-logo.svg?url';
import { base } from '../lib/site';
import { SECTIONS } from '../lib/sections';

const docsUrl = 'https://github.com/ArmandoHerra/pdf-tooling#readme';
const githubUrl = 'https://github.com/ArmandoHerra/pdf-tooling';
---

<header class="sticky top-0 z-50 border-b border-surface-800 bg-surface-900/90 backdrop-blur">
  <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-primary-500 focus:px-4 focus:py-2 focus:font-semibold focus:text-surface-900">
    Skip to content
  </a>
  <nav aria-label="primary" class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
    <a href={base} class="flex shrink-0 items-center gap-3">
      <img src={PdfToolingLogo} alt="" width="32" height="32" />
      <span class="text-lg font-bold tracking-tight text-surface-50">pdf-tooling</span>
    </a>

    <!-- PDF-92 D4: this row is allowed to WRAP onto a second line instead of
         forcing the header wider than the viewport. A non-wrapping row with
         all six register entries plus Docs measured 725-854px of required
         width against a 640px viewport across four label/spacing variants
         (E9) -- a document-level horizontal-scroll regression at a width
         AC17 does not sample and the inherited preflight sweep cannot see. -->
    <div class="hidden min-w-0 flex-1 flex-wrap items-center justify-end gap-x-8 gap-y-2 text-sm font-medium text-surface-100 sm:flex">
      {SECTIONS.map((section) => (
        <a href={`#${section.id}`} class="hover:text-primary-400">{section.label}</a>
      ))}
      <a href={docsUrl} class="hover:text-primary-400">Docs</a>
    </div>

    <a
      href={githubUrl}
      class="flex shrink-0 items-center gap-2 rounded-lg border border-surface-800 px-4 py-2 text-sm font-semibold text-surface-50 transition hover:border-primary-400 hover:text-primary-400"
    >
      <svg width="18" height="18" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
        <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/>
      </svg>
      GitHub
    </a>
  </nav>

  <!-- PDF-92 D1/D3: the always-visible mobile anchor rail. An always-visible
       rail, never a disclosure -- nothing opens, so nothing can be stuck
       open, and there is no focus trap to get wrong (DECISION decision 3).
       Real links only: no button, no aria-expanded, no aria-controls, no
       live region, and zero JavaScript -- there is no open/close state to
       keep truthful. -->
  <nav aria-label="sections" class="border-t border-surface-800/60 sm:hidden">
    <ul role="list" class="hide-scrollbar flex snap-x snap-proximity gap-2 overflow-x-auto scroll-px-4 px-6 py-2">
      {SECTIONS.map((section) => (
        <li class="shrink-0 snap-start">
          <a
            href={`#${section.id}`}
            class="flex min-h-11 items-center rounded-lg px-3 text-sm font-medium text-surface-100 hover:text-primary-400"
          >
            {section.short}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<style>
  /* Visual-only: the scroll affordance is the clipped last chip (D3), not a
     visible scrollbar. Purely presentational CSS -- no behaviour depends on
     it, and prefers-reduced-motion does not apply because nothing here
     moves on its own (D8). */
  .hide-scrollbar {
    scrollbar-width: none; /* Firefox */
    -ms-overflow-style: none; /* legacy Edge */
  }
  .hide-scrollbar::-webkit-scrollbar {
    display: none; /* Chromium, Safari */
  }
</style>
