---
import PdfToolingLogo from '../assets/pdf-tooling-logo.svg?url';
import { base, withBase } from '../lib/site';
import { SECTIONS } from '../lib/sections';

interface Props {
  /** PDF-94 D4. Default = today's behaviour (relative in-page anchors),
   *  so `index.astro`'s own `<Navbar />` call needs no change. `false` on
   *  `licensing.astro`, where none of `SECTIONS`' ids exist on this page --
   *  those links become absolute round-trips back to `/` instead. `#main`
   *  is unaffected: both pages carry their own main landmark with that id. */
  home?: boolean;
}

const { home = true } = Astro.props;
const sectionHref = (id: string) => (home ? `#${id}` : `${base}#${id}`);

const docsUrl = 'https://github.com/ArmandoHerra/pdf-tooling#readme';
const githubUrl = 'https://github.com/ArmandoHerra/pdf-tooling';
// PDF-94 D4: the annex route did not exist before this item, so this is the
// only item that can add it to the link set.
const inventoryUrl = withBase('licensing/');
---

<header class="sticky top-0 z-50 border-b border-line bg-surface-900/72 backdrop-blur-md backdrop-saturate-150">
  <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-primary-500 focus:px-4 focus:py-2 focus:font-semibold focus:text-surface-950">
    Skip to content
  </a>
  <!-- The bottom hairline carries a 36px `line-mark` segment under the
       wordmark -- the navbar's one drafting accent. -->
  <div class="pointer-events-none absolute bottom-[-1px] left-6 h-[2px] w-9 bg-line-mark" aria-hidden="true"></div>
  <nav aria-label="primary" class="mx-auto flex max-w-6xl items-center justify-between gap-x-6 px-6 py-4">
    <a href={base} class="flex shrink-0 items-center gap-3">
      <img src={PdfToolingLogo} alt="" width="32" height="32" />
      <span class="font-mono text-lg font-semibold tracking-tight text-surface-50">pdf<span class="text-primary-400">-</span>tooling</span>
    </a>

    <!-- PDF-92 D4: this row is allowed to WRAP onto a second line instead of
         forcing the header wider than the viewport. A non-wrapping row with
         all six register entries plus Docs measured 725-854px of required
         width against a 640px viewport across four label/spacing variants
         (E9) -- a document-level horizontal-scroll regression at a width
         AC17 does not sample and the inherited preflight sweep cannot see. -->
    <div class="hidden min-w-0 flex-1 flex-wrap items-center justify-end gap-x-5 gap-y-2 text-sm font-medium text-surface-300 sm:flex">
      {SECTIONS.map((section) => (
        <a href={sectionHref(section.id)} class="hover:text-primary-400">{section.label}</a>
      ))}
      <a href={inventoryUrl} class="hover:text-primary-400">All packages</a>
      <a href={docsUrl} class="hover:text-primary-400">Docs</a>
    </div>

    <a
      href={githubUrl}
      class="flex shrink-0 items-center gap-2 rounded-md border border-line-strong px-4 py-2 text-sm font-semibold text-surface-50 transition hover:border-line-ink hover:text-primary-400"
    >
      <svg width="18" height="18" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
        <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/>
      </svg>
      GitHub
    </a>
  </nav>

  <!-- PDF-92 D1/D3: the always-visible mobile anchor rail. An always-visible
       rail, never a disclosure -- nothing opens, so nothing can be stuck
       open, and there is no focus trap to get wrong (DECISION decision 3).
       Real links only: no button, no aria-expanded, no aria-controls, no
       live region, and zero JavaScript -- there is no open/close state to
       keep truthful. -->
  <nav aria-label="sections" class="border-t border-line sm:hidden">
    <ul role="list" class="hide-scrollbar flex snap-x snap-proximity gap-2 overflow-x-auto scroll-px-4 px-6 py-2">
      {SECTIONS.map((section) => (
        <li class="shrink-0 snap-start">
          <a
            href={sectionHref(section.id)}
            class="flex min-h-11 items-center rounded-md px-3 text-sm font-medium text-surface-300 hover:text-primary-400"
          >
            {section.short}
          </a>
        </li>
      ))}
      <li class="shrink-0 snap-start">
        <a
          href={inventoryUrl}
          class="flex min-h-11 items-center rounded-md px-3 text-sm font-medium text-surface-300 hover:text-primary-400"
        >
          All packages
        </a>
      </li>
    </ul>
  </nav>
</header>

<style>
  /* Visual-only: the scroll affordance is the clipped last chip (D3), not a
     visible scrollbar. Purely presentational CSS -- no behaviour depends on
     it, and prefers-reduced-motion does not apply because nothing here
     moves on its own (D8). */
  .hide-scrollbar {
    scrollbar-width: none; /* Firefox */
    -ms-overflow-style: none; /* legacy Edge */
  }
  .hide-scrollbar::-webkit-scrollbar {
    display: none; /* Chromium, Safari */
  }
</style>
