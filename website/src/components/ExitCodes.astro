---
// Re-derived from src/pdf_toolkit/cli/exit_codes.py at PDF-16 Phase B
// (2026-08-31) — codes, names and count are unchanged from Phase A: seven
// codes, matching PLAN.md §5.6 and ALL_EXIT_CODES exactly. The donor sites
// show six; this product adds AUTH.
//
// Cell 0's meaning prose deliberately omits the struck "a dry run is also
// 0" clause — do not "correct" it back in. Operator ruling OR-7 struck that
// clause (PLAN.md:325, "superseded by OR-7, 2026-08-30"): under OR-7 a dry
// run mirrors the exit code the real run would produce, so a completed
// --dry-run is emphatically not always 0 (e.g. `convert --dry-run` with no
// soffice present completes and exits 3). Per ruling X-142, the CODE and
// NAME still come from exit_codes.py, but the meaning prose must not
// restate a clause a ruling has struck — so this cell states OK truthfully
// instead. When this note was written the source docstring still carried the
// struck clause and this cell knowingly diverged from it; B-101 (2026-08-31)
// has since corrected exit_codes.py, so the two now AGREE. The note stays as
// the guard that keeps an honest re-derivation from any older copy of the
// docstring from walking the clause back in.
const codes = [
  { code: '0', name: 'OK', label: 'Success — including an empty-but-valid report. A --dry-run mirrors the code the real run would return, so it is not always 0.' },
  { code: '1', name: 'FAILURE', label: 'The operation ran and failed — corrupt input, engine error, unwritable destination.' },
  { code: '2', name: 'USAGE', label: 'Bad invocation — unknown flag, mutually exclusive flags, malformed page range, unknown subcommand.' },
  { code: '3', name: 'ENGINE_MISSING', label: 'A required engine or binary is unavailable. The message always carries an install hint.' },
  { code: '4', name: 'NO_INPUT', label: 'Valid invocation, nothing to act on.' },
  { code: '5', name: 'REFUSED', label: 'A safety gate declined.' },
  { code: '6', name: 'AUTH', label: 'Password required, incorrect, or of the wrong kind.' },
];
---

<section class="mx-auto max-w-6xl px-6 py-24">
  <div class="mx-auto max-w-2xl text-center">
    <h2 class="text-3xl font-bold tracking-tight text-surface-50 sm:text-4xl">
      A stable exit-code contract
    </h2>
    <p class="mt-4 text-lg text-surface-100">
      Seven codes, uniform across every verb — the same contract <code class="rounded bg-surface-900 px-1.5 py-0.5 font-mono text-sm text-primary-400">pdftoolkit --version</code> and
      the source both agree on.
    </p>
  </div>

  <div class="mt-12 grid grid-cols-2 gap-4 sm:grid-cols-4 lg:grid-cols-7">
    {codes.map((c) => (
      <div class="rounded-xl border border-surface-800 bg-surface-800/40 p-5 text-center">
        <p class="font-mono text-2xl text-primary-400">{c.code}</p>
        <p class="mt-1 font-mono text-[11px] font-semibold uppercase tracking-wide text-surface-50">{c.name}</p>
        <p class="mt-2 text-xs leading-snug text-surface-100">{c.label}</p>
      </div>
    ))}
  </div>
</section>
