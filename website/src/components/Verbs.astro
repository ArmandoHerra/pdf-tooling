---
// PDF-97 D1/D3/D4/D5. Rewritten: the 26-row roster now lives in
// `../lib/verbs.ts` (a typed module, not local data) and this component
// only consumes it -- imports `verbs` and `familyOrder`, derives
// `available` / `planned` / `groups` exactly as the previous version did,
// and declares no roster of its own.
//
// D3 -- density. The old layout was 26 near-identical cards in a grid,
// 2,993px at 1440px and 27% of the page. This version is a chip map (every
// verb as a small monospace anchor, clustered by family, the whole block
// readable at a glance) OVER a set of detail rows (one line per verb: name,
// then purpose) -- not a second copy of the same information, the same 26
// rows read at two densities. Zero JavaScript: no filter, no search, no
// script -- 26 items sit in the DOM and `Ctrl-F` already searches their
// purposes too (`PDF-16` AC11/AC12).
//
// D4 -- the drift sentence is now TRUE and names its instrument:
// `tests/test_website_contract.py::test_the_website_verb_roster_is_the_live_
// command_tree` asserts this module's 26 names are set-equal to
// `discover_verbs()` (the product's own CLI, walked recursively, no skip
// list) on every pull request and every deploy, replacing the previous
// unchecked "checked against pdftooling --help at every deploy" claim.
//
// D5 -- two false/unsourced claims the previous footer carried are gone,
// not restyled: `config` and `completion` do not exist on the live CLI
// (both answer "No such command" at exit code 2 -- measured), and the
// Phase 2 parked list (`redaction`, `outline editing`, `attachments`,
// `run recipes`) has no source in `README.md` or `CONTRIBUTING.md` and this
// site was its only carrier tree-wide. The one true, sourced statement in
// that neighbourhood -- Phase 1 (v1) complete -- now lives in the
// production-posture section instead (`Posture.astro`, D7).
import { verbs, familyOrder, type Verb } from '../lib/verbs';
import Prose from './Prose.astro';
import { langOf, pick } from '../lib/i18n';
import { VERB_PURPOSES_ES, FAMILIES_ES } from '../lib/copy-es';

const available = verbs.filter((v) => v.status === 'available');
const planned = verbs.filter((v) => v.status === 'planned');

const groups = familyOrder
  .map((family) => ({ family, items: verbs.filter((v: Verb) => v.family === family) }))
  .filter((g) => g.items.length > 0);

/** `meta get` -> `meta-get`, for the `#verb-<slug>` row anchor. */
const slug = (name: string) => name.replace(/\s+/g, '-');

// AC11 note: the two count expressions above stay COMPUTED in both
// languages -- only the noun after the number forks. Nothing below types
// a roster, a count, or a grouping key; the Spanish side supplies purposes
// keyed by the verb's own untranslated name and family headings keyed by
// the untranslated grouping id, so the roster remains `verbs.ts`'s alone.
// The page-range grammar's own spellings, listed once. Rendered through a
// map with an explicit `', '` separator rather than as seven hand-written
// tags: source whitespace between a `</code>` and the following comma is
// stripped by the compiler, which rendered the list as "even,odd, first,last"
// with the spacing landing in different places than it was typed.
const RANGE_TOKENS = ['1-3,5,9-', 'even', 'odd', 'first', 'last', '-1', '!5'] as const;

const esLang = langOf(Astro.url) === 'es';
const localized = (v: Verb) =>
  esLang ? { ...v, purpose: VERB_PURPOSES_ES[v.name] ?? v.purpose } : v;
const famName = (f: string) => (esLang ? (FAMILIES_ES[f] ?? f) : f);

const t = pick(Astro.url, {
  eyebrow: 'Commands',
  headingRest: ' commands, one grammar',
  plannedNote: ' are specified and not yet released. ',
  plannedNoteLead: 'Commands marked ',
  plannedWord: 'planned',
  introA:
    'Everything you would otherwise assemble from several separate tools, with one way to say which pages you mean. Every command that takes page numbers uses the same range grammar: ',
  introB: '. You learn it once. This list is checked against ',
  introC: ' on every release, so it cannot drift from the tool you installed.',
  chipMapLabel: 'All commands, grouped by family',
  familyHeading: (fam: string, n: number) => `${fam} family, ${n} commands`,
  runLead: 'Run ',
  runRest: ' for the whole tree.',
}, {
  eyebrow: 'Comandos',
  headingRest: ' comandos, una sola gram\u00e1tica',
  plannedNoteLead: 'Los comandos marcados como ',
  plannedNote: ' ya est\u00e1n especificados pero todav\u00eda no se publican. ',
  plannedWord: 'planeado',
  introA:
    'Lo que de otro modo armar\u00edas con varias herramientas distintas, con una sola forma de decir qu\u00e9 p\u00e1ginas quieres. Todo comando que direcciona p\u00e1ginas acepta la misma gram\u00e1tica de rangos: ',
  introB: '. La aprendes una sola vez. Esta lista se verifica contra ',
  introC: ' en cada versi\u00f3n, as\u00ed que no puede desviarse de la herramienta que instalaste.',
  chipMapLabel: 'Todos los comandos, agrupados por familia',
  familyHeading: (fam: string, n: number) => `familia ${fam}, ${n} comandos`,
  runLead: 'Corre ',
  runRest: ' para ver el \u00e1rbol completo.',
});
---

<section id="verbs" class="u-crop mx-auto max-w-6xl px-6 py-24">
  <p class="micro text-surface-400"><span class="text-primary-400">&sect;03</span> / {t.eyebrow}</p>
  <div class="u-reveal-rule mt-3 h-px w-full bg-line" aria-hidden="true"></div>
  <h2 class="mt-6 max-w-2xl text-3xl font-semibold tracking-tight text-surface-50 sm:text-4xl u-num">
    {available.length}{t.headingRest}
  </h2>
  <p class="mt-3 max-w-3xl text-lg text-surface-300">
    {planned.length > 0 && (
      <>{t.plannedNoteLead}<strong>{t.plannedWord}</strong>{t.plannedNote}</>
    )}
    {t.introA}{RANGE_TOKENS.map((token, i) => (
      <>{i > 0 && ', '}<code class="code-inline text-sm">{token}</code></>
    ))}{t.introB}<code
      class="code-inline text-sm">pdftooling --help</code>{t.introC}
  </p>

  <ul class="verb-chip-map mt-8 space-y-3" aria-label={t.chipMapLabel}>
    {groups.map((g) => (
      <li>
        <h4 id={`chip-${g.family}`} class="visually-hidden">{t.familyHeading(famName(g.family), g.items.length)}</h4>
        <p aria-hidden="true" class="micro mb-1.5 text-surface-400">
          {famName(g.family)} <span class="text-surface-500">{g.items.length}</span>
        </p>
        <ul aria-labelledby={`chip-${g.family}`} class="flex flex-wrap gap-1.5">
          {g.items.map((v) => (
            <li>
              <a
                href={`#verb-${slug(v.name)}`}
                class="chip inline-flex min-h-6 min-w-6 items-center justify-center rounded-sm border border-primary-500/10 bg-primary-500/10 px-2 py-0.5 font-mono text-xs font-semibold text-primary-400 hover:underline"
              >
                {v.name}
              </a>
            </li>
          ))}
        </ul>
      </li>
    ))}
  </ul>

  <div class="verb-detail mt-10 space-y-6">
    {groups.map((g) => (
      <div>
        <div class="mb-2 flex items-center gap-4">
          <h3 class="micro shrink-0 text-surface-400">{famName(g.family)} &middot; {g.items.length}</h3>
          <div class="h-px flex-1 bg-line" aria-hidden="true"></div>
        </div>
        <div class="grid grid-cols-1 gap-x-8 lg:grid-cols-2">
          {g.items.map(localized).map((v) => (
            <div
              id={`verb-${slug(v.name)}`}
              class="verb-row flex flex-col gap-x-4 border-b border-line-soft py-1.5 sm:grid sm:grid-cols-[7.5rem_1fr] sm:items-baseline"
            >
              <span class="flex items-center gap-2 font-mono text-sm font-semibold text-primary-400">
                {v.name}
                {v.status === 'planned' && (
                  <span class="micro rounded-xs bg-surface-750 px-2 py-1 text-surface-300">
                    {t.plannedWord}
                  </span>
                )}
              </span>
              <p class="text-sm leading-snug text-surface-200"><Prose text={v.purpose} /></p>
            </div>
          ))}
        </div>
      </div>
    ))}
  </div>

  <p class="mt-6 max-w-2xl text-sm text-surface-300">
    {t.runLead}<code class="code-inline text-xs">pdftooling --help</code>{t.runRest}
  </p>
</section>
