---
// Data-driven verb roster. `status` is derived from `pdftoolkit --help`
// (re-run at implementation time, PDF-16 Phase A, 2026-08-29), NOT from
// PLAN.md §4.1 or this spec's text — that is the whole point of honesty
// rule 7. At Phase A the CLI prints exactly one command: `version`
// (PDF-01's placeholder). Every verb in PLAN.md §4.1 (25 rows) is therefore
// `planned`; `version` joins `doctor` and `info` in the `diagnostics` group
// per PDF-16 spec §D5, so the roster totals 26, not the 25 the spec's own
// prose assumed. See the PDF-16 Implementation Log for this divergence.
type Verb = { name: string; port: string; purpose: string; status: 'available' | 'planned' };

const verbs: Verb[] = [
  { name: 'doctor', port: 'diagnostics', purpose: "Report each port's resolved adapter, version, and OS-aware install hint for what is missing.", status: 'planned' },
  { name: 'info', port: 'diagnostics', purpose: 'Page count/sizes, encryption + permission bits, metadata, producer, font list, signature presence, per-page rotation.', status: 'planned' },
  { name: 'version', port: 'diagnostics', purpose: 'Report the tool, runtime and engine versions.', status: 'available' },
  { name: 'merge', port: 'structure', purpose: 'Concatenate PDFs; per-input page selection via path:range; outline entry per source file.', status: 'planned' },
  { name: 'split', port: 'structure', purpose: 'One PDF → many, by fixed chunk size, explicit ranges, per page, or at top-level bookmarks.', status: 'planned' },
  { name: 'extract', port: 'structure', purpose: 'Write the selected pages to a new PDF, in the order given.', status: 'planned' },
  { name: 'delete', port: 'structure', purpose: 'Write everything except the selected pages.', status: 'planned' },
  { name: 'rotate', port: 'structure', purpose: 'Rotate the selected pages by a multiple of 90°, absolute or relative.', status: 'planned' },
  { name: 'reorder', port: 'structure', purpose: 'Rewrite page order from an explicit sequence; duplicates allowed, order preserved.', status: 'planned' },
  { name: 'repair', port: 'structure', purpose: "Structural recovery of a damaged/malformed PDF via libqpdf's recovery parser.", status: 'planned' },
  { name: 'linearize', port: 'structure', purpose: 'Rewrite for byte-serving ("fast web view").', status: 'planned' },
  { name: 'permissions', port: 'structure', purpose: 'Report the permission bits and encryption algorithm of an encrypted PDF.', status: 'planned' },
  { name: 'meta get', port: 'structure', purpose: 'Read the document information dictionary + XMP.', status: 'planned' },
  { name: 'meta set', port: 'structure', purpose: 'Write/clear document information fields and XMP.', status: 'planned' },
  { name: 'rasterize', port: 'raster', purpose: 'PDF → PNG/JPEG/TIFF/WEBP at a chosen DPI or pixel width.', status: 'planned' },
  { name: 'compose', port: 'compose', purpose: 'Images → PDF. JPEG inputs embed as DCTDecode streams (byte-preserving, no re-encode).', status: 'planned' },
  { name: 'create', port: 'compose', purpose: 'Text (v1) → PDF. Markdown/HTML behind the [html] extra (Phase 2).', status: 'planned' },
  { name: 'text', port: 'text', purpose: 'Extract text: fast path (pdfium) or layout-aware (pdfplumber) with per-block geometry.', status: 'planned' },
  { name: 'tables', port: 'text', purpose: 'Detect and extract tables to CSV/JSON.', status: 'planned' },
  { name: 'compress', port: 'optimize', purpose: 'Shrink: libqpdf object streams plus stream recompression (lossless), optional Pillow image downsample/recompress (lossy).', status: 'planned' },
  { name: 'encrypt', port: 'crypto', purpose: 'Apply AES-256 (or RC4-128 with --legacy) with user/owner passwords and a permission set.', status: 'planned' },
  { name: 'decrypt', port: 'crypto', purpose: 'Remove encryption given the correct password.', status: 'planned' },
  { name: 'watermark', port: 'overlay', purpose: 'Overlay/underlay generated text across the selected pages.', status: 'planned' },
  { name: 'stamp', port: 'overlay', purpose: 'Overlay/underlay an existing PDF page onto the selected pages.', status: 'planned' },
  { name: 'ocr', port: 'overlay', purpose: 'Add a Tesseract text layer over untouched pixels — a text-only PDF generated per page and merged.', status: 'planned' },
  { name: 'convert', port: 'external', purpose: 'Office → PDF via headless LibreOffice.', status: 'planned' },
];

const available = verbs.filter((v) => v.status === 'available');
const planned = verbs.filter((v) => v.status === 'planned');

const portOrder = ['diagnostics', 'structure', 'raster', 'compose', 'text', 'optimize', 'crypto', 'overlay', 'external'];
const groups = portOrder
  .map((port) => ({ port, items: verbs.filter((v) => v.port === port) }))
  .filter((g) => g.items.length > 0);
---

<section id="verbs" class="mx-auto max-w-6xl px-6 py-24">
  <div class="mx-auto max-w-2xl text-center">
    <h2 class="text-3xl font-bold tracking-tight text-surface-50 sm:text-4xl">
      {available.length} shipped &middot; {planned.length} planned
    </h2>
    <p class="mt-4 text-lg text-surface-100">
      Verbs marked <strong>planned</strong> are specified and not yet shipped. This list is
      checked against <code class="rounded bg-surface-900 px-1.5 py-0.5 font-mono text-sm text-primary-400">pdftoolkit --help</code> at every deploy.
    </p>
  </div>

  <div class="mt-16 space-y-12">
    {groups.map((g) => (
      <div>
        <h3 class="mb-4 text-xs font-semibold uppercase tracking-widest text-surface-100/70">{g.port}</h3>
        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {g.items.map((v) => (
            <div class="rounded-xl border border-surface-800 bg-surface-800/40 p-6">
              <div class="mb-4 flex flex-wrap items-center gap-2">
                <span class="inline-flex items-center justify-center rounded-lg border border-primary-500/40 bg-primary-500/10 px-3 py-1.5 text-sm font-bold tracking-wide text-primary-400 font-mono">
                  {v.name}
                </span>
                {v.status === 'planned' && (
                  <span class="rounded bg-surface-800 px-2 py-1 text-[10px] font-semibold uppercase tracking-wide text-surface-100">
                    planned
                  </span>
                )}
              </div>
              <p class="text-sm leading-relaxed text-surface-100">{v.purpose}</p>
            </div>
          ))}
        </div>
      </div>
    ))}
  </div>

  <p class="mt-8 text-center text-sm text-surface-100">
    config and completion round out the surface — run <code class="rounded bg-surface-900 px-1.5 py-0.5 font-mono text-xs text-primary-400">pdftoolkit --help</code> for the whole tree.
    Phase 2 (HTML/Markdown create, redaction, forms, outline editing, attachments/annotations,
    run recipes) is parked, additive on the same spine.
  </p>
</section>
